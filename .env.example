# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL connection string (asyncpg driver)
# Docker Compose default — change host/credentials for non-Docker setups
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/travel_planner

# HS256 JWT signing secret — must be at least 32 characters
JWT_SECRET=change-me-to-a-random-32-plus-char-secret

# ── Auth (optional, defaults shown) ──────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── LLM models (optional, defaults shown) ────────────────────────────────────
# Haiku: cost-optimised tool selection
CHEAP_MODEL=claude-haiku-4-5-20251001
# Sonnet: high-quality final synthesis
STRONG_MODEL=claude-sonnet-4-20250514

# ── RAG (optional, defaults shown) ───────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Weather API (optional, defaults shown) ────────────────────────────────────
WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Seconds to cache weather responses in-process (0 to disable)
WEATHER_CACHE_TTL=600

# ── Notifications (optional, leave blank to disable) ─────────────────────────
# Discord incoming webhook URL — trip summaries are posted here after each plan
DISCORD_WEBHOOK_URL=
